# =============================================================================
# Athena Desktop Examination & Proctoring Application - Environment Configuration
# =============================================================================

# Port for the Express examination backend service (default: 6001)
PORT=6001
EXAM_BACKEND_PORT=6001

# Vite / Frontend Backend Port configuration (default: 6001)
VITE_BACKEND_PORT=6001

# Exam Duration in minutes (default: 45)
EXAM_DURATION_MINUTES=45

# Optional: Custom Data Storage Directory (defaults to ./backend/data)
# DATA_DIR=./backend/data

# Electron Development Settings
# Set to 'false' to suppress DevTools in development
# ELECTRON_OPEN_DEVTOOLS=false
