# =============================================================================
# Athena Desktop Examination & Proctoring Application - Environment Configuration
# =============================================================================
# Copy this file to .env or .env.local to customize your environment.
# Note: In production, secrets should never be checked into version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Backend Service Configuration
# -----------------------------------------------------------------------------
# Port where the Express examination backend service will listen (default: 6001)
PORT=6001
EXAM_BACKEND_PORT=6001

# Optional custom directory for backend JSON persistence (default: ./backend/data)
# DATA_DIR=./backend/data

# -----------------------------------------------------------------------------
# 2. Frontend / Vite Client Configuration
# -----------------------------------------------------------------------------
# Port for the backend service referenced by the Vite React client
VITE_BACKEND_PORT=6001

# Optional full base URL for the backend API (defaults to http://localhost:${VITE_BACKEND_PORT})
VITE_BACKEND_URL=http://localhost:6001

# -----------------------------------------------------------------------------
# 3. Assessment & Session Settings
# -----------------------------------------------------------------------------
# Authoritative examination duration in minutes (default: 45)
# The main process computes deadlines as epoch timestamps and strictly clamps remaining time at 0.
EXAM_DURATION_MINUTES=45

# -----------------------------------------------------------------------------
# 4. Electron Main Process & Security Controls
# -----------------------------------------------------------------------------
# Node environment mode ('development' or 'production')
NODE_ENV=development

# Controls automatic opening of Chrome DevTools in development (default: true)
# NOTE: DevTools and inspect shortcuts are strictly disabled in production builds.
ELECTRON_OPEN_DEVTOOLS=true

# -----------------------------------------------------------------------------
# 5. Proctoring & Evidence Capture Policy
# -----------------------------------------------------------------------------
# Frequency for periodic webcam snapshots during an active exam in seconds (default: 60)
SNAPSHOT_INTERVAL_SECONDS=60

# Evidence retention duration in days (default: 30)
RETENTION_DAYS=30

# Hard cap on the number of snapshots preserved per session to avoid disk exhaustion (default: 100)
MAX_SNAPSHOTS_PER_SESSION=100

# Absolute maximum video recording size cap in bytes (default: 104857600 = 100 MB)
MAX_RECORDING_BYTES=104857600
