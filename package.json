{
  "name": "athena",
  "productName": "Athena",
  "description": "Secure desktop examination and proctoring platform",
  "author": "Athena Project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "start:prod": "vite build && electron . --prod",
    "dev": "vite",
    "dev:electron": "electron .",
    "dev:react": "vite",
    "build": "vite build",
    "package": "vite build && electron-builder --dir",
    "package:mac": "vite build && electron-builder --mac --dir",
    "dist": "vite build && electron-builder",
    "dist:mac": "vite build && electron-builder --mac",
    "lint": "eslint .",
    "backend": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^41.10.7",
    "electron-builder": "^26.18.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.athena.exam",
    "productName": "Athena",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "!backend/data/sessions.json",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dir"
      ]
    }
  }
}
